# Optional — the NLP Agent falls back to rule-based classification without it.
# Get a free key at https://aistudio.google.com/
GEMINI_API_KEY=

# Optional — enables live Kaggle dataset search (Dataset Collection Agent).
# Without it, discovery/evaluation just use the local catalog. Get a token at
# https://www.kaggle.com/settings/api ("Generate New Token"), then paste the
# token value here (not a kaggle.json file path — this project's installed
# kaggle package version uses a single token string, not the older
# username+key / kaggle.json scheme).
KAGGLE_API_TOKEN=

# Recommended for auth — a persistent JWT signing secret. Without it, a
# random one is generated at process start, so existing tokens are
# invalidated every restart. Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=

# Optional overrides
# GEMINI_MODEL=gemini-3.5-flash
# NLP_SPACY_MODEL=en_core_web_sm
# DISCOVERY_EMBEDDING_MODEL=all-MiniLM-L6-v2
# ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# JWT_EXPIRY_HOURS=2
# DATABASE_URL=sqlite:////absolute/path/to/database/app.db
